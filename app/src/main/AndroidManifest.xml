<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Faz 27: rastgele "geri gel" hatirlatma bildirimleri icin (Android 13+ zorunlu). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Faz 105: coklu patlama titresimi. DIKKAT — bu izin bugune kadar YOKTU, ama
         RetroSoundManager Faz 78'den beri vibrator.vibrate() cagiriyordu: izinsiz
         cagri SecurityException firlatir, kod da onu yutuyordu (catch { }). Yani
         Retro Modu'nun titresimi ve ayarlarindaki "Titreşim" anahtari bugune kadar
         hicbir sey yapmiyordu; bu izinle o da gercekten calisir hale geliyor.
         VIBRATE "normal" izindir: runtime izin diyalogu yok, Data Safety'ye etkisi
         yok, magaza listesinde kullaniciyi urkutecek bir sey gostermez. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Gercek AdMob App ID (2026-08-08, kullanicinin AdMob konsolunda bu oyun icin olusturuldu). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8582550349019790~6836467085" />
        <!-- Faz 52: configChanges olmadan ekran dondurme (orientation) Activity'yi
             BASTAN yaratiyordu — oyunun tum bellek-ici durumu (tahta, skor, tepsi;
             hepsi Compose remember{} ile tutuluyor, kalici degil) sifirlaniyordu.
             Kullanici bunu "tablette dondurunce sıradaki blokla degisiyor" olarak
             fark etti. Activity artik rotasyonu/ekran boyutu degisimini KENDISI
             yonetiyor, yeniden yaratilmiyor — Compose state'i korunuyor. Tablet-
             adaptif grid layout'u (Faz 40, BoxWithConstraints) buna ragmen normal
             calismaya devam eder, cunku o zaten yeniden olcum icin Activity
             yeniden yaratilmasina bagli degildi. -->
        <!-- Faz 90: kullanici tablette yatay ekranda Mod Secim izgarasinin
             (aspectRatio(1f) kartlar) ust uste bindigini bildirdi. Hizli/kesin
             cozum olarak dikey kilitlendi — responsive izgara alternatifi
             degerlendirildi ama kullanici bu secenegi tercih etti. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
